rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function isSubAdmin() {
      return isSignedIn() && myRole() == 'subadmin';
    }
    // Dùng để CHẶN Sub-admin (Giám đốc) khỏi các thao tác "Giải trình" —
    // GĐ chỉ được Xem + Duyệt/Từ chối, việc giải chi thuộc về Kế toán (User) và Admin.
    function isNotSubAdmin() {
      return isSignedIn() && myRole() != 'subadmin';
    }
    // Nhận diện giao dịch được HỆ THỐNG tự tạo khi 1 Lệnh chi/Tạm ứng được DUYỆT
    // (không phải do người dùng tự tay tạo/giải trình) — cho phép việc này xảy ra
    // như một HỆ QUẢ của hành động Duyệt hợp lệ của GĐ, nhưng KHÔNG cho phép GĐ
    // tự ý tạo giao dịch nào khác (kể cả qua luồng Giải trình).
    function isSystemGeneratedFromApproval() {
      return request.resource.data.note is string && request.resource.data.note.matches('^Tự động tạo từ.*');
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // User thường được phép tự đổi trạng thái Hóa đơn / Chuyển khoản (không đổi field khác)
    function isSimpleStatusUpdate() {
      return isSignedIn() && changedKeys().hasOnly(['invoiceStatus','transferStatus']);
    }
    // Bất kỳ ai cũng được GỬI DUYỆT một khoản Chi cho GĐ (chuyển trạng thái sang 'pending')
    function isApprovalSubmit() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approverRole','approverEmail','approvalSubmittedAt','approvedBy','approvedAt'])
        && request.resource.data.approvalStatus == 'pending';
    }
    // Chỉ đúng email GĐ đã được gán (resource.data.approverEmail) mới được DUYỆT/TỪ CHỐI
    // Danh sách người được phép Duyệt/Từ chối (Giám đốc + người duyệt phụ) — tra động từ settings,
    // KHÔNG còn phụ thuộc đúng 1 email cố định ghi sẵn trên từng bản ghi như trước.
    function isAuthorizedApprover() {
      return request.auth.token.email in
        get(/databases/$(database)/documents/settings/approvers).data.approverEmails;
    }
    function isApprovalDecision() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approvedBy','approvedAt'])
        && (request.resource.data.approvalStatus == 'approved' || request.resource.data.approvalStatus == 'rejected')
        && isAuthorizedApprover();
    }
    // Đánh dấu 1 khoản Chi phí gián tiếp là "đã giải trình" (sau khi tạo xong giao dịch chính thức bên Thu Chi)
    function isExplainUpdate() {
      return isSignedIn()
        && changedKeys().hasOnly(['advanceExplainStatus','movedToTransactionId','explainedAt','explainedBy'])
        && request.resource.data.advanceExplainStatus == 'explained';
    }
    // Y hệt trên nhưng dùng riêng cho Lệnh chi (paymentOrders)
    function isOrderApprovalSubmit() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approverRole','approverEmail','approvalSubmittedAt','approvedBy','approvedAt'])
        && request.resource.data.approvalStatus == 'pending';
    }
    function isOrderApprovalDecision() {
      return isSignedIn()
        // Cho phép ghi kèm transactionId/transactionCollection CÙNG LÚC với quyết định duyệt —
        // vì đây là 1 hành động DUY NHẤT (Duyệt lệnh -> tự động liên kết giao dịch vừa tạo ra).
        && changedKeys().hasOnly(['approvalStatus','approvedBy','approvedAt','transactionId','transactionCollection'])
        && (request.resource.data.approvalStatus == 'approved' || request.resource.data.approvalStatus == 'rejected')
        && isAuthorizedApprover();
    }

    // Hồ sơ vai trò của từng người dùng (admin / user)
    match /users/{uid} {
      allow read: if isSignedIn();
      // Cho phép 2 trường hợp tạo mới:
      // 1) Người dùng tự tạo hồ sơ CỦA CHÍNH MÌNH lần đầu đăng nhập (mặc định role=user).
      // 2) Admin tạo/gán hồ sơ (kèm vai trò) cho một người khác (kể cả người đó chưa từng đăng nhập).
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isNotSubAdmin();
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isSignedIn();
      // User/Admin nhập mới tự do; Sub-admin (GĐ) CHỈ được phép tạo khi đây là giao dịch
      // hệ thống tự sinh ra do chính GĐ vừa Duyệt 1 lệnh (không được tự tay tạo/giải trình).
      allow create: if isSignedIn() && (isNotSubAdmin() || isSystemGeneratedFromApproval());
      // riêng đổi trạng thái Hóa đơn/Chuyển khoản và luồng Gửi duyệt/Duyệt/Từ chối Chi: KHÔNG áp dụng cho Sub-admin (GĐ chỉ xem).
      allow update: if isAdmin() || (isNotSubAdmin() && isSimpleStatusUpdate()) || (isNotSubAdmin() && isApprovalSubmit()) || isApprovalDecision() || (isNotSubAdmin() && isExplainUpdate());
      allow delete: if isAdmin();
    }

    // Chi phí gián tiếp (không gắn dự án cụ thể) — quyền y hệt transactions, thêm luồng "giải trình"
    match /fixedCosts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isNotSubAdmin() || isSystemGeneratedFromApproval());
      // isExplainUpdate (đánh dấu đã giải trình): CHỈ Kế toán (User)/Admin — GĐ không được quyền giải chi.
      allow update: if isAdmin() || (isNotSubAdmin() && isSimpleStatusUpdate()) || (isNotSubAdmin() && isApprovalSubmit()) || isApprovalDecision() || (isNotSubAdmin() && isExplainUpdate());
      allow delete: if isAdmin();
    }

    // Cài đặt chung (VD: email GĐ duyệt chi) — ai cũng đọc được, chỉ Admin sửa
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Lịch sử chỉnh sửa (audit log) — ai đăng nhập cũng được GHI (để tự ghi lại thao tác của chính mình),
    // nhưng chỉ Admin mới ĐỌC được (không cho User xem lịch sử của người khác), và không ai sửa/xóa được (đảm bảo tính toàn vẹn).
    match /activityLog/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /paymentOrders/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotSubAdmin();
      // User thường được sửa lệnh chi khi CHƯA gửi duyệt (approvalStatus rỗng/'none'),
      // được GỬI DUYỆT (chuyển sang 'pending'), tự do ghi Giải trình bất kỳ lúc nào; Admin thì sửa/xóa tự do.
      // Sub-admin (GĐ): KHÔNG được sửa/giải trình gì cả — chỉ Duyệt/Từ chối (isOrderApprovalDecision, role-agnostic theo email).
      // Chỉ đúng email GĐ đã được gán (resource.data.approverEmail) mới được DUYỆT/TỪ CHỐI.
      allow update: if isAdmin() || (isNotSubAdmin() && isOrderApprovalSubmit()) || isOrderApprovalDecision()
        || (isNotSubAdmin() && changedKeys().hasOnly(['explanation','explainAllocations','explainedAt','explainedBy','explainStatus','attachment','attachmentName']))
        || (isNotSubAdmin() && (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'none' || resource.data.approvalStatus == '')
          && changedKeys().hasOnly(['date','projectId','projectName','code','orderType','payer','payee','payeeBank','payeeTaxCode','reason','amount','requester','note','explanation','attachment','attachmentName']));
      // Kế toán (User)/Admin được quyền xóa Lệnh chi/Lệnh tạm ứng — Sub-admin (GĐ) thì KHÔNG.
      allow delete: if isSignedIn() && isNotSubAdmin();
    }

    match /employees/{id} {
      allow read: if isSignedIn();
      allow write: if isNotSubAdmin();
    }

    match /payrollAdjustments/{id} {
      allow read: if isSignedIn();
      allow write: if isNotSubAdmin();
    }

    match /timesheets/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isNotSubAdmin();
    }
  }
}
