rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ cho phép người dùng ĐÃ ĐĂNG NHẬP (có tài khoản do bạn tạo trong
    // Firebase Authentication) mới được đọc/ghi dữ liệu.
    // Không ai truy cập được nếu chưa đăng nhập -> an toàn khi để public trên GitHub Pages.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
