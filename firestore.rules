rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // User thường được phép tự đổi trạng thái Hóa đơn / Chuyển khoản (không đổi field khác)
    function isSimpleStatusUpdate() {
      return isSignedIn() && changedKeys().hasOnly(['invoiceStatus','transferStatus']);
    }
    // Bất kỳ ai cũng được GỬI DUYỆT một khoản Chi cho GĐ (chuyển trạng thái sang 'pending')
    function isApprovalSubmit() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approverRole','approverEmail','approvalSubmittedAt','approvedBy','approvedAt'])
        && request.resource.data.approvalStatus == 'pending';
    }
    // Chỉ đúng email GĐ đã được gán (resource.data.approverEmail) mới được DUYỆT/TỪ CHỐI
    function isApprovalDecision() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approvedBy','approvedAt'])
        && (request.resource.data.approvalStatus == 'approved' || request.resource.data.approvalStatus == 'rejected')
        && resource.data.approverEmail == request.auth.token.email;
    }
    // Đánh dấu 1 khoản Chi phí gián tiếp là "đã giải trình" (sau khi tạo xong giao dịch chính thức bên Thu Chi)
    function isExplainUpdate() {
      return isSignedIn()
        && changedKeys().hasOnly(['advanceExplainStatus','movedToTransactionId','explainedAt','explainedBy'])
        && request.resource.data.advanceExplainStatus == 'explained';
    }
    // Y hệt trên nhưng dùng riêng cho Lệnh chi (paymentOrders)
    function isOrderApprovalSubmit() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approverRole','approverEmail','approvalSubmittedAt','approvedBy','approvedAt'])
        && request.resource.data.approvalStatus == 'pending';
    }
    function isOrderApprovalDecision() {
      return isSignedIn()
        && changedKeys().hasOnly(['approvalStatus','approvedBy','approvedAt'])
        && (request.resource.data.approvalStatus == 'approved' || request.resource.data.approvalStatus == 'rejected')
        && resource.data.approverEmail == request.auth.token.email;
    }

    // Hồ sơ vai trò của từng người dùng (admin / user)
    match /users/{uid} {
      allow read: if isSignedIn();
      // Cho phép 2 trường hợp tạo mới:
      // 1) Người dùng tự tạo hồ sơ CỦA CHÍNH MÌNH lần đầu đăng nhập (mặc định role=user).
      // 2) Admin tạo/gán hồ sơ (kèm vai trò) cho một người khác (kể cả người đó chưa từng đăng nhập).
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isSignedIn();
      // User thường chỉ được NHẬP MỚI giao dịch; sửa/xóa toàn bộ chỉ Admin;
      // riêng đổi trạng thái Hóa đơn/Chuyển khoản và luồng Gửi duyệt/Duyệt/Từ chối Chi thì User cũng được (có kiểm soát field).
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSimpleStatusUpdate() || isApprovalSubmit() || isApprovalDecision();
      allow delete: if isAdmin();
    }

    // Chi phí gián tiếp (không gắn dự án cụ thể) — quyền y hệt transactions, thêm luồng "giải trình"
    match /fixedCosts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSimpleStatusUpdate() || isApprovalSubmit() || isApprovalDecision() || isExplainUpdate();
      allow delete: if isAdmin();
    }

    // Cài đặt chung (VD: email GĐ duyệt chi) — ai cũng đọc được, chỉ Admin sửa
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Lịch sử chỉnh sửa (audit log) — ai đăng nhập cũng được GHI (để tự ghi lại thao tác của chính mình),
    // nhưng chỉ Admin mới ĐỌC được (không cho User xem lịch sử của người khác), và không ai sửa/xóa được (đảm bảo tính toàn vẹn).
    match /activityLog/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /paymentOrders/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // User thường được sửa lệnh chi khi CHƯA gửi duyệt (approvalStatus rỗng/'none'),
      // được GỬI DUYỆT (chuyển sang 'pending'), tự do ghi Giải trình bất kỳ lúc nào; Admin thì sửa/xóa tự do.
      // Chỉ đúng email GĐ đã được gán (resource.data.approverEmail) mới được DUYỆT/TỪ CHỐI.
      allow update: if isAdmin() || isOrderApprovalSubmit() || isOrderApprovalDecision()
        || (isSignedIn() && changedKeys().hasOnly(['explanation','explainAllocations','explainedAt','explainedBy','explainStatus','attachment','attachmentName']))
        || (isSignedIn() && (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'none' || resource.data.approvalStatus == '')
          && changedKeys().hasOnly(['date','projectId','projectName','code','orderType','payer','payee','payeeBank','payeeTaxCode','reason','amount','requester','note','explanation','attachment','attachmentName']));
      // Kế toán (bất kỳ ai đăng nhập) được quyền xóa Lệnh chi/Lệnh tạm ứng — theo đúng yêu cầu công ty.
      allow delete: if isSignedIn();
    }

    match /employees/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payrollAdjustments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timesheets/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
